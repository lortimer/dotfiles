# Aliases

## History

### Bash
HISTSIZE=100000
HISTFILESIZE=100000
export PROMPT_COMMAND='history -a'

### Zsh
HISTFILE=~/.zhistory
SAVEHIST=100000   
setopt APPEND_HISTORY
setopt share_history
setopt HIST_IGNORE_SPACE # don't put in history commands that start with a space

## Terminal
alias x='tput reset'
alias ls='ls -a'

### Bash
alias resource='source ~/.bashrc'
alias rs='source ~/.bashrc'
alias bashp='nano ~/.bash_profile'

### Zsh
alias resource='source ~/.zshrc'
alias rs='source ~/.zshrc'
alias bashp='nano ~/.zshrc'
alias zp='nano ~/.zshrc'

apt-where(){
   dpkg -L "$1";
}
grepp(){
   grep -A 10 -B 10 "$1";
}

greppp(){
   grep -A 100000 -B 100000 "$1";
}

update(){
   sudo apt update;
   sudo apt upgrade;
   flatpak update;
}

## Git
alias gs='git status'
alias gl='git log'
alias gpl='git pull'
alias gps='git push'
alias gpsf='git push --force-with-lease'
alias ga='git add .'
alias g-='git switch -'
alias grc='git rebase --continue'
gc() {
   git commit -m "$1";
}
gb() {
   git checkout -b $1;
   git push --set-upstream origin $1;
}
gdb() {
   git branch -d "$1";
   git push origin --delete "$1";
}

### Add git branch to command prompt if it is present

parse_git_branch() {
    git rev-parse --abbrev-ref HEAD 2> /dev/null
}

#### Bash
PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[01;35m\]$(parse_git_branch)\[\033[00m\]\$ '

### Zsh
COLOR_DEF='%f'  
COLOR_USR='%F{243}'
COLOR_DIR='%F{197}'
COLOR_GIT='%F{39}'
setopt PROMPT_SUBST
export PROMPT='${COLOR_USR}%n ${COLOR_DIR}%2~ ${COLOR_GIT}$(parse_git_branch)${COLOR_DEF}%% '
